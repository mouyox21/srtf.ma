# Copy this file to .env.local for local development with `npx vercel dev`.
# In production, configure these under Vercel → Project → Settings → Environment Variables.

# Resend (https://resend.com) API key used by /api/contact to send form submissions by e-mail.
RESEND_API_KEY=

# Mailbox that receives contact form submissions.
CONTACT_TO_EMAIL=contact@srtf.ma

# Optional — verified "from" address/display name for outgoing mail.
CONTACT_FROM_EMAIL=SRTF <contact@srtf.ma>
